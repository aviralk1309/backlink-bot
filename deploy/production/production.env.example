# Build-time public Supabase settings. The anon key is designed to be public;
# database access still depends on RLS and app authorization.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-project-anon-key

# Web runtime
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
APP_URL=https://app.example.com
MAIL_FROM="Backlink Bot <no-reply@example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password

# Worker runtime. Copy the session-pooler URI from Supabase Connect and use the
# worker role username (worker.<project-ref>); URL-encode reserved password characters.
DATABASE_URL=postgresql://worker.project-ref:replace-me@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
LOG_LEVEL=INFO
WORKER_CONCURRENCY=2
POOL_MAX_SIZE=4
SERPER_API_KEY=
SEARCH_ENABLED=false
SITE_CRAWL_ENABLED=false
LINK_VERIFICATION_ENABLED=false
BOT_USER_AGENT="BacklinkBot/1.0 (+https://example.com/bot; ops@example.com)"

# Remote-managed Cloudflare Tunnel token; publish app.example.com to http://web:3000.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
